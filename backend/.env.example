# Copy this file to .env and change the secret in real deployments.
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Comma-separated list of origins allowed to call this API (the Next.js dev server by default)
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=sqlite:///./bloodconnect.db
